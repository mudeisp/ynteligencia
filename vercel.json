{
  "redirects": [
    {
      "source": "/es",
      "destination": "https://www.yincorp.com.br/es",
      "permanent": true
    },
    {
      "source": "/es/:rest*",
      "destination": "https://www.yincorp.com.br/es/:rest*",
      "permanent": true
    },
    {
      "source": "/sp",
      "destination": "https://www.yincorp.com.br/sp",
      "permanent": true
    },
    {
      "source": "/sp/:rest*",
      "destination": "https://www.yincorp.com.br/sp/:rest*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/portal/lead",
      "destination": "/api/lead"
    },
    {
      "source": "/sitemap-portal.xml",
      "destination": "/api/development?portalPath=/sitemap-portal.xml"
    },
    {
      "source": "/:uf(ac|al|ap|am|ba|ce|df|es|go|ma|mt|ms|mg|pa|pb|pr|pe|pi|rj|rn|rs|ro|rr|sc|sp|se|to)",
      "destination": "/api/development?portalPath=/:uf"
    },
    {
      "source": "/:uf(ac|al|ap|am|ba|ce|df|es|go|ma|mt|ms|mg|pa|pb|pr|pe|pi|rj|rn|rs|ro|rr|sc|sp|se|to)/:rest*",
      "destination": "/api/development?portalPath=/:uf/:rest*"
    }
  ],
  "crons": [
    {
      "path": "/api/push-daily",
      "schedule": "0 13 * * *"
    }
  ]
}
